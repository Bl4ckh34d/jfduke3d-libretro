+        fprintf(stderr,"Duke quicksave result=%d pos=%d,%d\n",result,ps[myconnectindex].posx,ps[myconnectindex].posy);
+    } else {
+        int result=loadplayer(9);
+        fprintf(stderr,"Duke quickload result=%d pos=%d,%d\n",result,ps[myconnectindex].posx,ps[myconnectindex].posy);
+    }
+    return 1;
+}
