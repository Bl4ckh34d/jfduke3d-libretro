+void Duke_RTSCleanup(void)
+{
+    for (int i = 0; i < numlumps; ++i) {
+        int seen = 0;
+        for (int j = 0; j < i; ++j) if (lumpinfo[j].handle == lumpinfo[i].handle) seen = 1;
+        if (!seen) kclose(lumpinfo[i].handle);
+    }
+    free(lumpinfo); lumpinfo = NULL;
+    free(lumpcache); lumpcache = NULL;
+    numlumps = 0; RTS_Started = false;
+}
