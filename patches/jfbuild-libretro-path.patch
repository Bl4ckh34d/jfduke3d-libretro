+void Duke_ClearSearchPaths(void)
+{
+    while (searchpathhead) {
+        searchpath_t *next = searchpathhead->next;
+        free(searchpathhead->path);
+        free(searchpathhead);
+        searchpathhead = next;
+    }
+    maxsearchpathlen = 0;
+    pathsearchmode = 0;
+}
+
